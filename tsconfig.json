{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "types": ["node"],
        "paths": {
            "@werkraum/ausstello-next/client": ["./src/client/index.ts"]
        }
    },
    "include": ["src", "test"]
}
